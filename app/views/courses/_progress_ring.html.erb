<% percent = total.zero? ? 0 : (completed * 100.0 / total).round %>
<div class="flex items-center gap-4 mb-6">
  <div class="relative inline-flex items-center justify-center">
    <svg viewBox="0 0 100 100" class="w-24 h-24 -rotate-90">
       <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor"
               class="text-gray-200" stroke-width="8" />
       <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor"
               class="text-blue-600" stroke-width="8" stroke-linecap="round"
               stroke-dasharray="282.7"
               stroke-dashoffset="<%= (282.7 * (100 - percent) / 100.0).round(1) %>" />
    </svg>
    <span class="absolute text-sm font-semibold"><%= percent %>%</span>
  </div>
  <p class="text-sm text-gray-600"><%= completed %> of <%= total %> lessons completed</p>
</div>
