<h1 class="text-2xl font-bold"><%= @course.title %></h1>
<p class="text-gray-600 mb-4"><%= @course.description %></p>
<% enrolled = current_user&.enrollments&.exists?(course: @course) %>
<div class="mb-6">
  <% if enrolled %>
    <span class="text-green-700 font-semibold">Enrolled</span>
    <%= button_to "Unenroll", course_enrollment_path(@course), method: :delete,
                  class: "text-red-600", data: { turbo_confirm: "Leave this course?" } %>
  <% else %>
    <%= button_to "Enroll", course_enrollment_path(@course), method: :post,
                  class: "text-blue-600" %>
  <% end %>
</div>
<% if current_user&.admin? %>
  <div class="mb-6">
    <%= link_to "Edit course", edit_course_path(@course), class: "text-blue-600" %>
    <%= button_to "Delete course",
                  course_path(@course),
                  method: :delete,
                  class: "text-red-600",
                  data: { turbo_confirm: "Delete this course?" } %>
  </div>
<% end %>
<% @course.sections.order(:position).each do |section| %>
  <div class="mb-6">
    <h2 class="text-lg font-semibold">
      <%= section.position %>. <%= link_to section.title, section_path(section) %>
    </h2>
    <ul class="ml-4 list-disc">
      <% section.lessons.order(:position).each do |lesson| %>
        <li><%= link_to lesson.title, lesson_path(lesson) %></li>
      <% end %>
    </ul>
    <% if current_user&.admin? %>
      <%= link_to "Add lesson", new_section_lesson_path(section), class: "text-sm text-blue-600" %>
    <% end %>
  </div>
<% end %>
<% if current_user&.admin? %>
  <%= link_to "Add section", new_course_section_path(@course), class: "text-blue-600" %>
<% end %>
