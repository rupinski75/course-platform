<h2 class="text-2xl font-bold mb-4">Log in</h2>
<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="mb-4">
    <%= f.label :email, class: "block mb-1 font-semibold" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "w-full rounded border border-gray-300 p-2" %>
  </div>
  <div class="mb-4">
    <%= f.label :password, class: "block mb-1 font-semibold" %>
    <%= f.password_field :password, autocomplete: "current-password",
          class: "w-full rounded border border-gray-300 p-2" %>
  </div>
  <% if devise_mapping.rememberable? %>
    <div class="mb-4 flex items-center gap-2">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, class: "font-normal" %>
    </div>
  <% end %>
  <%= f.submit "Log in", class: "bg-blue-600 text-white rounded px-4 py-2 cursor-pointer" %>
<% end %>
<div class="mt-4 text-sm text-gray-600">
  <%= render "devise/shared/links" %>
</div>
