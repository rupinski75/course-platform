<%= form_with model: section.persisted? ? section : [course, section] do |form| %>
  <% if section.errors.any? %>
    <div class="bg-red-100 text-red-800 rounded p-3 mb-4">
      <ul>
        <% section.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= form.label :title %>
    <%= form.text_field :title, class: "border rounded w-full p-2" %>
  </div>
  <div class="mb-3">
    <%= form.label :position %>
    <%= form.number_field :position, class: "border rounded w-full p-2" %>
  </div>
  <%= form.submit class: "btn btn-primary" %>
<% end %>
