<h1 class="text-2xl font-bold mb-4"><%= @lesson.title %></h1>
<div class="mb-6"><%= simple_format @lesson.content %></div>
<% completed = current_user&.lesson_completions&.exists?(lesson: @lesson) %>
<div class="mb-6">
  <% if completed %>
    <span class="text-green-700 font-semibold">Completed</span>
    <%= button_to "Remove completion", lesson_completion_path(@lesson), method: :delete,
                  class: "text-red-600" %>
  <% else %>
    <%= button_to "Mark as completed", lesson_completion_path(@lesson), method: :post,
                  class: "text-blue-600" %>
  <% end %>
</div>
<% if current_user&.admin? %>
  <div class="mb-6">
    <%= link_to "Edit lesson", edit_lesson_path(@lesson), class: "text-blue-600" %>
  </div>
<% end %>
<%= link_to "Back to #{@lesson.section.title}", section_path(@lesson.section), class: "text-sm text-gray-500" %>
