<h1 class="text-2xl font-bold mb-4"><%= @lesson.title %></h1>
<div class="mb-6 lesson-content"><%= @lesson.rendered_content %></div>
<% completed = current_user&.lesson_completions&.exists?(lesson: @lesson) %>
<div class="mb-6">
  <% if completed %>
    <%= button_to "Lesson completed", lesson_completion_path(@lesson), method: :delete,
                  class: "btn btn-success" %>
  <% else %>
    <%= button_to "Mark complete", lesson_completion_path(@lesson), method: :post,
                  class: "btn btn-primary" %>
  <% end %>
</div>
<% if current_user&.admin? %>
  <div class="mb-6">
    <%= link_to "Edit lesson", edit_lesson_path(@lesson), class: "btn btn-secondary" %>
  </div>
<% end %>
<%= link_to "Back to #{@lesson.section.title}", section_path(@lesson.section), class: "btn btn-secondary" %>
