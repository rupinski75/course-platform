<%# if lesson persisted in the db we use shallow route for the lesson. Full sections/:id/lessons route insted %>
<%= form_with model: lesson.persisted? ? lesson : [section, lesson] do |form| %>
  <% if lesson.errors.any? %>
    <div class="bg-red-100 text-red-800 rounded p-3 mb-4">
      <ul>
        <% lesson.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= form.label :title %>
    <%= form.text_field :title, class: "border rounded w-full p-2" %>
  </div>
  <div class="mb-3">
    <%= form.label :content %>
    <%= form.textarea :content %>
  </div>
  <div class="mb-3">
    <%= form.label :position %>
    <%= form.number_field :position, class: "border rounded w-full p-2" %>
  </div>
  <%= form.submit class: "btn btn-primary" %>
<% end %>
